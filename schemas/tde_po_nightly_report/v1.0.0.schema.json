{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyra.local/schemas/tde_po_nightly_report/v1.0.0.schema.json",
  "title": "TDE Product Owner Nightly Report",
  "type": "object",
  "required": [
    "artifactType",
    "schemaVersion",
    "report_id",
    "report_date",
    "product_id",
    "product_name",
    "product_owner",
    "overall_health",
    "summary",
    "top_priorities",
    "blockers",
    "risks",
    "proposed_tde_actions",
    "evidence_links",
    "source_reference"
  ],
  "properties": {
    "artifactType": { "const": "tde_po_nightly_report" },
    "schemaVersion": { "const": "1.0.0" },
    "report_id": { "type": "string", "minLength": 1 },
    "report_date": { "type": "string", "format": "date" },
    "product_id": { "type": "string", "minLength": 1 },
    "product_name": { "type": "string", "minLength": 1 },
    "product_owner": { "type": "string", "minLength": 1 },
    "overall_health": { "type": "string", "enum": ["green", "yellow", "red"] },
    "summary": { "type": "string", "minLength": 5 },
    "top_priorities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "blocker_type", "next_step"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "blocker_type": { "type": "string", "enum": ["operational", "decision"] },
          "next_step": { "type": "string", "minLength": 1 },
          "linked_tde_id": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "impact"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "mitigation": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "proposed_tde_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "source_reference": { "type": "string", "minLength": 1 },
    "control_panel_priority": {
      "oneOf": [
        { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
