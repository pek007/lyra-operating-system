{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyra.local/schemas/tde_decision_policy_envelope/v1.0.0.schema.json",
  "title": "TDE Decision Policy Envelope",
  "type": "object",
  "required": [
    "artifactType",
    "schemaVersion",
    "policy_id",
    "workflow_family",
    "delegated_role",
    "escalation_role",
    "allowed_outcomes",
    "allowed_next_step_types",
    "confidence_threshold",
    "risk_threshold",
    "write_scope_boundary",
    "max_autonomous_hops",
    "retry_limit",
    "research_budget",
    "mandatory_escalation_triggers",
    "enabled"
  ],
  "properties": {
    "artifactType": { "const": "tde_decision_policy_envelope" },
    "schemaVersion": { "const": "1.0.0" },
    "policy_id": { "type": "string", "minLength": 1 },
    "workflow_family": { "type": "string", "minLength": 1 },
    "stage_family": { "type": ["string", "null"] },
    "delegated_role": { "type": "string", "const": "Product Owner" },
    "escalation_role": { "type": "string", "const": "Ultimate Decision-maker" },
    "allowed_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "continue",
          "branch",
          "block",
          "retry",
          "defer",
          "research_further"
        ]
      }
    },
    "allowed_next_step_types": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_branching_patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_evidence_types": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk_threshold": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "cost_threshold": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", null]
    },
    "write_scope_boundary": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "max_autonomous_hops": { "type": "integer", "minimum": 0 },
    "retry_limit": { "type": "integer", "minimum": 0 },
    "research_budget": {
      "type": "object",
      "required": ["max_rounds"],
      "properties": {
        "max_rounds": { "type": "integer", "minimum": 0 },
        "max_minutes": { "type": ["integer", "null"], "minimum": 0 },
        "max_tokens": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "mandatory_escalation_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "enabled": { "type": "boolean" },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
