{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyra.local/schemas/coord_status_event/v1.0.0.schema.json",
  "type": "object",
  "required": [
    "artifactType",
    "schemaVersion",
    "event_id",
    "at",
    "job_id",
    "session_key",
    "actor",
    "kind",
    "summary",
    "ttl_days",
    "safety"
  ],
  "properties": {
    "artifactType": { "const": "coord_status_event" },
    "schemaVersion": { "const": "1.0.0" },
    "event_id": { "type": "string", "minLength": 8 },
    "at": { "type": "string", "format": "date-time" },
    "job_id": { "type": "string", "minLength": 2 },
    "session_key": { "type": "string", "minLength": 2 },
    "actor": {
      "type": "object",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 2 },
        "subagent_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "enum": ["status", "blocker", "request", "handoff", "impact_notice"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
    "refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 20
    },
    "ttl_days": { "type": "integer", "minimum": 1, "maximum": 30, "default": 7 },
    "safety": {
      "type": "object",
      "required": ["non_sensitive"],
      "properties": {
        "non_sensitive": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "supersedes_event_id": { "type": "string" },
    "idempotency_key": { "type": "string" }
  },
  "additionalProperties": true
}
