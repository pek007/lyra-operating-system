{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyra.local/schemas/assembly.schema.json",
  "title": "Product Assembly Manifest",
  "type": "object",
  "required": [
    "assembly_id",
    "name",
    "version",
    "status",
    "owner",
    "artifacts",
    "distribution",
    "activation",
    "enforcement"
  ],
  "properties": {
    "assembly_id": { "type": "string", "pattern": "^A-[0-9]{3}$" },
    "name": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "status": { "enum": ["draft", "candidate", "stable", "deprecated"] },
    "owner": { "type": "string" },
    "value_promise": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": { "enum": ["service", "skill-pack", "policy-pack", "schema-pack", "ops-pack"] },
          "path": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["lane"],
      "properties": {
        "lane": { "type": "string" },
        "details": { "type": "string" }
      }
    },
    "activation": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "rollback": { "type": "string" }
      }
    },
    "enforcement": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "approval_gate": { "type": "string" },
        "evidence_required": { "type": "boolean" }
      }
    },
    "compatibility": { "type": "string" },
    "consumers": { "type": "array", "items": { "type": "string" } },
    "links": {
      "type": "object",
      "properties": {
        "changelog": { "type": "string" },
        "activation_doc": { "type": "string" },
        "verify_doc": { "type": "string" }
      }
    }
  }
}
